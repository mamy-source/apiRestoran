PORT= 9000

# ===============================
# DATABASE (MySQL)
# ===============================
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=miekely
# DB_PASSWORD='Admin123#'
# DB_NAME=apiResto

DATABASE_URL= "mysql://miekely:Admin123%23@localhost:3306/apiResto"
NODE_ENV=development


# ===============================
# JWT AUTHENTICATION
# ===============================
JWT_SECRET="super-secret-jwt-key-2025-resto-app"
JWT_REFRESH_SECRET="super-secret-refresh-key-2025-resto-app"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ===============================
# ARGON2 (Password hashing)
# ===============================
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ===============================
# GUEST SESSION
# ===============================
SESSION_SECRET="session-secret-key-resto-app-2025"
SESSION_EXPIRES_IN="30d"

# ===============================
# CORS (Cross-Origin Resource Sharing)
# ===============================
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:8080"
CORS_CREDENTIALS=true

# ===============================
# RATE LIMITING
# ===============================
RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100      # 100 requêtes par IP

# ===============================
# LOGGING
# ===============================
LOG_LEVEL=debug                    # debug amin'ny développement
LOG_DIR="./logs"
LOG_TO_FILE=true

# ===============================
# FRONTEND URL
# ===============================
FRONTEND_URL="http://localhost:5173"

# ===============================
# UPLOADS
# ===============================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

